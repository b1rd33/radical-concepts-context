        {
            "parameters": {
                "jsCode": "var episodeId = $(\"Clean Script\").item.json.episode_id;\nvar episodeTitle = $(\"Clean Script\").item.json.episode_title;\nvar fileName = \"episode-\" + episodeId.substring(0, 8) + \".mp3\";\nvar binaryData = $input.first().binary;\nvar jsonData = $input.first().json;\n\nif (!binaryData || Object.keys(binaryData).length === 0) {\n  throw new Error(\"Fish Audio error: \" + JSON.stringify(jsonData));\n}\n\nvar binaryKey = Object.keys(binaryData)[0];\n\nreturn [{\n  json: {\n    episode_id: episodeId,\n    episode_title: episodeTitle,\n    file_name: fileName,\n    tts_provider: $(\"Clean Script\").item.json.tts_provider,\n    voice_label: $(\"Clean Script\").item.json.voice_label\n  },\n  binary: {\n    audio: binaryData[binaryKey]\n  }\n}];\n"
            },
