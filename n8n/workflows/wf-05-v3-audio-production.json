        {
            "parameters": {
                "jsCode": "var episodes = $input.all().filter(function(item) { return item.json.id; });\n\nif (episodes.length === 0) {\n  throw new Error('No draft episodes found. Run WF-04 first.');\n}\n\nvar episode = episodes[0].json;\nvar hasAudio = !!episode.audio_url;\n\nreturn [{\n  json: {\n    episode_id: episode.id,\n    episode_title: episode.title,\n    script: episode.script,\n    audio_url: episode.audio_url || null,\n    has_audio: hasAudio,\n    status: episode.status\n  }\n}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -352,
                256
            ],
            "id": "c1aa7837-d994-4a9a-aab0-cf5360d508e9",
            "name": "Check Episode"
