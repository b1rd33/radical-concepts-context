        {
            "parameters": {
                "jsCode": "// Voice & Provider Selection\n// Providers: 'fish' or 'hume'\n// Voice modes: 'stock' or 'cloned'\nvar TTS_PROVIDER = 'fish';\nvar VOICE_MODE = 'stock';\n\n// Hume AI voices\nvar HUME_STOCK = '6b69954e-6c9a-4ade-ad03-f73e116e1eae';\nvar HUME_CLONED = '095d952c-971d-42ce-beb8-381e5c94ab2b';\n\n// Fish Audio voices\nvar FISH_STOCK = '802e3bc2b27e49c2995d23ef70e6ac89';\nvar FISH_CLONED = '15891e6b8799441da70f0016987a7885';\n\nvar voiceId, voiceLabel;\nif (TTS_PROVIDER === 'hume') {\n  voiceId = VOICE_MODE === 'cloned' ? HUME_CLONED : HUME_STOCK;\n  voiceLabel = VOICE_MODE === 'cloned' ? 'Brett (Hume)' : 'Stock Australian (Hume)';\n} else {\n  voiceId = VOICE_MODE === 'cloned' ? FISH_CLONED : FISH_STOCK;\n  voiceLabel = VOICE_MODE === 'cloned' ? 'Brett (Fish)' : 'Stock Male (Fish)';\n}\n\nvar episode = $input.first().json;\n\nreturn [{\n  json: {\n    episode_id: episode.episode_id,\n    episode_title: episode.episode_title,\n    script: episode.script,\n    tts_provider: TTS_PROVIDER,\n    voice_id: voiceId,\n    voice_mode: VOICE_MODE,\n    voice_label: voiceLabel\n  }\n}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                96,
                352
            ],
            "id": "0546b364-55ef-4ce7-96a3-2effee90e344",
            "name": "Select Voice"
        },
        {
            "parameters": {
                "jsCode": "var script = $json.script || \"\";\nvar voiceId = $json.voice_id;\n\nvar segmentMarker = \"=== SEGMENT\";\nvar segmentStart = script.indexOf(segmentMarker);\nvar ttsText = \"\";\nif (segmentStart >= 0) {\n  var lineEnd = script.indexOf(String.fromCharCode(10), segmentStart);\n  var contentStart = lineEnd + 1;\n  var nextMarker = script.indexOf(String.fromCharCode(10) + \"===\", contentStart);\n  if (nextMarker > contentStart) {\n    ttsText = script.substring(contentStart, nextMarker).trim();\n  } else {\n    ttsText = script.substring(contentStart).trim();\n  }\n} else {\n  ttsText = script.substring(0, 5000);\n}\n\nvar cleanText = ttsText\n  .substring(0, 5000)\n  .replace(/\\[.*?\\]/g, \"\")\n  .replace(/\\\\/g, \"\")\n  .replace(/\"/g, \"\")\n  .replace(/\\n/g, \" \")\n  .replace(/\\r/g, \"\")\n  .replace(/\\t/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nvar ttsBody = JSON.stringify({\n  text: cleanText,\n  reference_id: voiceId,\n  format: \"mp3\",\n  mp3_bitrate: 128\n});\n\nreturn [{\n  json: {\n    clean_text: cleanText,\n    text_length: cleanText.length,\n    tts_body: ttsBody,\n    voice_id: voiceId,\n    tts_provider: $json.tts_provider,\n    episode_id: $json.episode_id,\n    episode_title: $json.episode_title,\n    voice_label: $json.voice_label\n  }\n}];\n"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                320,
                352
            ],
            "id": "bdeef37e-8424-432d-bbbe-4e1dca2e8793",
            "name": "Clean Script"
        },
        {
