                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ text: $json.clean_text, reference_id: $json.voice_id, format: \"mp3\", mp3_bitrate: 128 }) }}",
                "options": {
                    "response": {
