    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Get the RSS articles from 'Limit to 10 Articles' node\nconst rssItems = $('Limit to 10 Articles').all();\n\n// Get existing URLs from Supabase 'Get Recent URLs' node\nconst existingUrls = new Set(\n  $('Get Recent URLs').all().map(item => item.json.url).filter(Boolean)\n);\n\n// Filter out articles whose URL already exists in Supabase\nconst newItems = rssItems.filter(item => {\n  const articleUrl = item.json.link || item.json.url || '';\n  return !existingUrls.has(articleUrl);\n});\n\n// Return new items (or empty array if all are duplicates)\nreturn newItems.map(item => ({ json: item.json }));"
      },
