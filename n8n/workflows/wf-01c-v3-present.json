    {
      "parameters": {
        "jsCode": "var presented = $('Unpack Articles').all();\nvar seen = {};\nvar result = [];\nfor (var i = 0; i < presented.length; i++) {\n  var url = presented[i].json.url;\n  if (url && !seen[url]) {\n    seen[url] = true;\n    result.push({json: {url: url}});\n  }\n}\nreturn result;"
      },
