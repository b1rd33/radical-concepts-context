        {
            "parameters": {
                "jsCode": "var prepData = $('Prepare Presentation').first().json;\nvar chatIds = $('Config').first().json.CHAT_IDS || ['1240314255'];\nvar articles = prepData.articles || [];\nvar result = [];\nfor (var c = 0; c < chatIds.length; c++) {\n  for (var j = 0; j < articles.length; j++) {\n    var a = articles[j];\n    var urlPath = (a.url || '').split('?')[0];\n    var pathPart = urlPath.length > 30 ? urlPath.substring(urlPath.length - 30) : urlPath;\n    var score = parseFloat(a.score) || parseFloat(a.header_score) || parseFloat(a.composite_score) || 0;\n    var source = a.source || a.source_name || a.feed_name || 'News';\n    result.push({\n      json: {\n        chat_id: chatIds[c],\n        title: a.title || '',\n        url: a.url || '',\n        category: a.category || 'other',\n        header_score: score,\n        source_count: parseInt(a.source_count) || 1,\n        feed_name: source,\n        approve_cb: 'a:' + pathPart\n      }\n    });\n  }\n}\nif (result.length === 0) return [{json: {_empty: true}}];\nreturn result;"
            },
