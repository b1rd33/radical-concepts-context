{
  "name": "[WF-01c-v3] Present to Brett",
  "nodes": [
    {
      "parameters": {},
      "id": "93ebb404-5746-455f-b268-4827e6c78872",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -800,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "var CONFIG = {CHAT_IDS: ['1240314255','8509710128'], SEND_TELEGRAM: true};\nreturn [{json: CONFIG}];"
      },
      "id": "1cc97692-e13c-4175-a855-46eeef64bfbf",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        200
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "articles",
        "returnAll": true,
        "filterType": "string",
        "filterString": "status=eq.curated"
      },
      "id": "ea3909b8-1c7f-44f8-b1ef-dd0faba1d112",
      "name": "Get Curated",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -400,
        200
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "k5u4E7DLyRpsGAB0",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "var articles = $input.all().filter(function(i) { return i.json.id; });\nif (articles.length === 0) throw new Error('No curated articles. Run WF-01b first.');\nreturn articles;"
      },
      "id": "aa3c06a9-b31e-4dbb-8369-06f1d1fd9788",
      "name": "Check Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "var items = $input.all();\nvar catCounts = {};\nvar catEmojis = {\n  politics: '\\ud83c\\udfe3',\n  geopolitics: '\\ud83c\\udf0d',\n  science: '\\ud83d\\udd2c',\n  tech: '\\ud83d\\udcbb',\n  economics: '\\ud83d\\udcc8',\n  quirky: '\\u2728'\n};\n\nvar articles = [];\nfor (var i = 0; i < items.length; i++) {\n  var a = items[i].json;\n  var meta = a.llm_metadata || a.metadata || {};\n  if (typeof meta === 'string') {\n    try { meta = JSON.parse(meta); } catch(e) { meta = {}; }\n  }\n  var cat = (meta.category || a.category || 'uncategorized').toLowerCase();\n  catCounts[cat] = (catCounts[cat] || 0) + 1;\n  articles.push({\n    title: a.title || 'Untitled',\n    url: a.url,\n    source: a.source_name || a.feed_title || 'Unknown',\n    category: cat,\n    score: a.composite_score || a.header_score || 0,\n    emoji: catEmojis[cat] || '\\ud83d\\udcf0'\n  });\n}\n\nvar summaryParts = [];\nfor (var c in catCounts) {\n  var emoji = catEmojis[c] || '\\ud83d\\udcf0';\n  summaryParts.push(emoji + ' ' + catCounts[c] + ' ' + c);\n}\nvar summaryText = 'Today: ' + items.length + ' curated articles. ' + summaryParts.join(', ') + '.';\n\nvar prompt = 'Write a 2-3 sentence morning briefing intro for Brett Moore. '\n  + 'He is an Australian entrepreneur and news junkie in Barcelona. '\n  + 'Today we have ' + items.length + ' curated articles: ' + summaryParts.join(', ') + '. '\n  + 'Be conversational, sharp, and brief. No fluff. Reference the mix of topics.';\n\nreturn [{\n  json: {\n    summary_prompt: prompt,\n    summary_text: summaryText,\n    articles: articles,\n    total_curated: items.length\n  }\n}];"
      },
      "id": "932ad531-ded9-435d-999c-7ef9a04dafca",
      "name": "Prepare Presentation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.summary_prompt }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write brief sharp morning news briefings. 2-3 sentences. Conversational."
            }
          ]
        },
        "hasOutputParser": false
      },
      "id": "b0db2500-0408-4c47-8f41-2b96bb7e6ac6",
      "name": "Write Morning Intro",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-4.1-nano",
        "options": {}
      },
      "id": "e3e70803-6df6-4bfb-9385-9396e44944b8",
      "name": "Intro Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        200,
        400
      ],
      "credentials": {
        "openRouterApi": {
          "id": "1HjiTjhZTVqv5vLc",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "90b62acb-46da-4006-9da6-e45aae1beaf1",
              "leftValue": "={{ $('Config').first().json.SEND_TELEGRAM }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "50830902-af4d-418c-b79c-f2df490bcec7",
      "name": "IF SEND_TELEGRAM",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "var chatIds = $('Config').first().json.CHAT_IDS;\nvar input = $input.first().json;\nvar introText = input.text || input.response || input.output || 'Good morning!';\nvar articles = $('Prepare Presentation').first().json.articles;\nvar summaryText = $('Prepare Presentation').first().json.summary_text;\nvar totalCurated = $('Prepare Presentation').first().json.total_curated;\n\nreturn chatIds.map(function(cid) {\n  return {\n    json: {\n      chat_id: cid,\n      intro_text: introText,\n      summary_text: summaryText,\n      articles: articles,\n      total_curated: totalCurated\n    }\n  };\n});"
      },
      "id": "4970ea06-739e-426e-9153-53ee7995ee0c",
      "name": "Expand to Chats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.intro_text + '\\n\\n' + $json.summary_text }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "9f9a81a2-96b3-4f67-9be8-af67e977639c",
      "name": "Send Morning Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        800,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "V1Z3rnsrUvXf0TPr",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "var items = $input.all();\nvar result = [];\nfor (var i = 0; i < items.length; i++) {\n  var chatId = items[i].json.chat_id;\n  var articles = items[i].json.articles || [];\n  for (var j = 0; j < articles.length; j++) {\n    var a = articles[j];\n    var urlPath = (a.url || '').split('?')[0];\n    var pathPart = urlPath.length > 30 ? urlPath.substring(urlPath.length - 30) : urlPath;\n    var approveCb = 'a:' + pathPart;\n    result.push({\n      json: {\n        chat_id: chatId,\n        title: a.title,\n        url: a.url,\n        source: a.source,\n        category: a.category,\n        score: a.score,\n        emoji: a.emoji,\n        approve_cb: approveCb,\n        article_index: j + 1\n      }\n    });\n  }\n}\nreturn result;"
      },
      "id": "039c55c5-a511-402c-ba97-3f97a41993ae",
      "name": "Unpack Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "id": "b9262f28-1faf-4e50-886b-e2c333186627",
      "name": "Loop Articles",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.emoji + ' [' + String(Math.round($json.score * 10) / 10) + '] ' + $json.title + '\\n' + '\\ud83d\\udcf0 ' + $json.source + '\\n' + '<a href=\"' + $json.url + '\">Read article</a>' }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Include in episode",
                    "additionalFields": {
                      "callback_data": "={{ $json.approve_cb }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "a03e96b7-2c7f-4f05-8c05-89201fd5976a",
      "name": "Send Card",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        400
      ],
      "continueOnFail": true,
      "credentials": {
        "telegramApi": {
          "id": "V1Z3rnsrUvXf0TPr",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "var presented = $('Unpack Articles').all();\nvar urls = {};\nfor (var i = 0; i < presented.length; i++) {\n  urls[presented[i].json.url] = true;\n}\nvar presentedCount = Object.keys(urls).length;\nvar totalRemaining = Math.max(0, 50 - presentedCount);\n\nreturn [{\n  json: {\n    presented_count: presentedCount,\n    remaining_estimate: totalRemaining\n  }\n}];"
      },
      "id": "3fcec913-58ba-4830-9366-e960ee5665e2",
      "name": "Count Remaining",
      "type": "n8n-nodes-base.code",
